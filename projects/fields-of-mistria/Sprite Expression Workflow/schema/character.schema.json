{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.sprite-workflow/schema/character.schema.json",
  "title": "Portrait Character Authoring Specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "display_name", "identity_anchor", "sprite_sets"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "display_name": { "type": "string", "minLength": 1 },
    "identity_anchor": {
      "type": "string",
      "minLength": 1,
      "description": "Stable physical identity only; no pose, emotion, outfit, or background."
    },
    "personality_notes": { "type": "string" },
    "physicality_notes": { "type": "string" },
    "sprite_sets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sprite_set" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "color": { "type": "string", "minLength": 1 },
    "background": {
      "type": "object",
      "additionalProperties": false,
      "required": ["top", "bottom"],
      "properties": {
        "top": { "$ref": "#/$defs/color" },
        "bottom": { "$ref": "#/$defs/color" }
      }
    },
    "expression_override": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instruction"],
      "properties": {
        "instruction": { "type": "string", "minLength": 1 }
      },
      "minProperties": 1
    },
    "sprite_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name", "asset_stem", "style", "expression_pack", "outfit_anchor", "references", "background"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "display_name": { "type": "string", "minLength": 1 },
        "asset_stem": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$",
          "description": "AI-readable filename stem. Final portraits use {asset_stem}_{expression}.png."
        },
        "style": { "$ref": "#/$defs/id" },
        "expression_pack": { "$ref": "#/$defs/id" },
        "outfit_anchor": { "type": "string", "minLength": 1 },
        "set_notes": { "type": "string" },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "role"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "role": { "enum": ["identity-base", "outfit-reference", "feature-reference"] },
              "notes": { "type": "string" }
            }
          }
        },
        "background": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "const": "character" },
            "top": { "$ref": "#/$defs/color" },
            "bottom": { "$ref": "#/$defs/color" }
          }
        },
        "expression_overrides": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/expression_override" }
        }
      }
    }
  }
}
